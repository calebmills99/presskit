---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Press"
  description="Press kit for Golden Wings: Stewardess to Sky Queen. Named awards, programmer delivery notes, and press@gwingz.studio."
  path="/press"
>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Press</span>
      <h1>Proof</h1>
      <blockquote class="quote">
        "A jet-setting odyssey that lands in your heart."
        <cite>Mary Lou Belli, Emmy-winning director</cite>
      </blockquote>
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="awards-heading">
    <div class="container">
      <h2 id="awards-heading">Named awards</h2>
      <ul class="awards-strip">
        <li>Best Cinematography · Silicon Beach Film Festival 2024</li>
        <li>Best Documentary Short · Guadalajara, Swedish International, and Clown</li>
        <li>Best Mobile Short · Independent Shorts Awards 2024</li>
        <li>TCL Chinese Theatre premiere</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Programmer kit</h2>
      <div class="card-grid">
        <article class="card">
          <h3>Title</h3>
          <p>Golden Wings: Stewardess to Sky Queen</p>
        </article>
        <article class="card">
          <h3>Runtime</h3>
          <p>~22 min</p>
        </article>
        <article class="card">
          <h3>Delivery</h3>
          <p>DCP / ProRes / screener on request</p>
        </article>
        <article class="card">
          <h3>Q&amp;A</h3>
          <p>Director + mother available for panels</p>
        </article>
      </div>
      <div class="prose" style="margin-top: var(--space-6);">
        <p><strong>Studio:</strong> GWINGZ STUDIO</p>
        <p>
          <strong>Programming / press:</strong>
          <a href="mailto:press@gwingz.studio">press@gwingz.studio</a>
        </p>
        <p>
          <strong>Site:</strong>
          <a href="https://www.golden-wings-robyn.com">www.golden-wings-robyn.com</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container prose">
      <h2>Still / step-and-repeat proof</h2>
      <p class="muted">
        TCL Chinese Theatre / Silicon Beach step-and-repeat proof assets.
      </p>
      <!-- TODO: Link stills kit, laurel pack, premiere photos when assets are staged. -->
      <p class="muted">TODO: stills kit · laurel pack · premiere photo links</p>
    </div>
  </section>
</BaseLayout>
