---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy policy for golden-wings-robyn.com and GWINGZ STUDIO."
  path="/privacy-policy"
>
  <section class="hero">
    <div class="container prose">
      <span class="eyebrow">Legal</span>
      <h1>Privacy Policy</h1>
      <p class="muted">Last updated: September 11, 2026</p>
      <p>
        This site is operated by GWINGZ STUDIO for the documentary
        <em>Golden Wings: Stewardess to Sky Queen</em>.
      </p>
      <h2>What we collect</h2>
      <p>
        If you email us or use the contact form, we receive the name, email address, and message
        you provide. We use that information only to respond to your inquiry.
      </p>
      <h2>Hosting and logs</h2>
      <p>
        Our hosting provider may collect standard server logs (IP address, user agent, pages
        requested) for security and operations. We do not sell personal information.
      </p>
      <h2>Cookies</h2>
      <p>
        This static rebuild does not set analytics cookies by default. If analytics or embeds are
        added later, this policy will be updated.
      </p>
      <h2>Contact</h2>
      <p>
        Privacy questions:
        <a href="mailto:press@gwingz.studio">press@gwingz.studio</a>
      </p>
    </div>
  </section>
</BaseLayout>
